# Postgres (must have the pgvector + pgcrypto extensions available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_deck

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Claude API — used for multi-query expansion and slide synthesis
ANTHROPIC_API_KEY=

# Voyage AI — used for embeddings (voyage-3) and re-ranking (rerank-2)
VOYAGE_API_KEY=

# Optional: OpenAlex needs no API key, but adding your email opts into
# its "polite pool" for higher, more reliable rate limits
OPENALEX_MAILTO=

# Python interpreter used to invoke scripts/generate_deck.py
PYTHON_BIN=python

# Base URL the worker uses to build download links (matches your Next.js deployment)
BASE_URL=http://localhost:3000

# Where generated .pptx files are written on the worker's host
DECK_OUTPUT_DIR=./generated
